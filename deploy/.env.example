# Klima — environment matrix (no secrets)
#
# Copy values into platform dashboards / `fly secrets` / local `.env`.
# Never commit real credentials.

# ── Shared ──────────────────────────────────────────────
# APP_MODE=production|development

# ── Backend (Fly / compose) ─────────────────────────────
# Required:
SECRET_KEY=
JWT_SECRET_KEY=
# APP_PORT=8080
# DB_DIALECT=sqlite          # or postgres
# SQLITE_FILE=/tmp/klima.db
# LOG_LEVEL=INFO

# Postgres (when DB_DIALECT=postgres):
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_DB=klima
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# ── Frontend (Vercel) ───────────────────────────────────
# NEXT_PUBLIC_KLIMA_API_URL=https://klima-api.fly.dev

# ── Docs (Vercel) ───────────────────────────────────────
# (static VitePress — no runtime secrets required)
