{
  "additionalProperties": false,
  "description": "LGU, barangay, NGO, or citizen community announcement.",
  "properties": {
    "author_name": {
      "title": "Author Name",
      "type": "string"
    },
    "author_type": {
      "default": "citizen",
      "title": "Author Type",
      "type": "string"
    },
    "contact_info": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contact Info"
    },
    "content": {
      "title": "Content",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "image_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Url"
    },
    "is_pinned": {
      "default": false,
      "title": "Is Pinned",
      "type": "boolean"
    },
    "tags": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tags"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "views": {
      "default": 0,
      "minimum": 0,
      "title": "Views",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "title",
    "content",
    "author_name",
    "timestamp"
  ],
  "title": "CommunityPostOut",
  "type": "object"
}
