# syntax=docker/dockerfile:1
#
# Klima data-pipeline runner (bronze -> silver medallion).
# Deliberately ships ONLY the pipeline runtime (duckdb/pandas/requests),
# never the FastAPI stack, to keep the image small. Builder and runtime share
# the same python:3.12-slim base so the /opt/venv is relocatable.
#
# Build (Podman preferred):
#   podman build -f Dockerfile.pipeline -t klima-pipeline .
# Run once:
#   podman run --rm -v klima-data:/data klima-pipeline run --stage all --reset

FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
# Keep this list in sync with the `pipeline` extra in pyproject.toml.
RUN uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python \
        "duckdb>=1.4.1" \
        "pandas>=2.3.3" \
        "requests>=2.32.5"

FROM python:3.12-slim AS runtime
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    KLIMA_DATA_DIR=/data
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY pipeline ./pipeline
RUN useradd --create-home --uid 10001 klima \
    && mkdir -p /data \
    && chown -R klima:klima /data /app
USER klima
VOLUME ["/data"]
ENTRYPOINT ["python", "-m", "pipeline"]
CMD ["run", "--stage", "all"]
